#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

git diff --cached --check

# Check both scopes before either formatter can modify files.
sh .githooks/pre-commit-android --preflight
sh .githooks/pre-commit-workflows --preflight
sh .githooks/pre-commit-android
sh .githooks/pre-commit-workflows
