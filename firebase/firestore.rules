rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return request.auth != null && exists(/databases/$(database)/documents/households/family/members/$(request.auth.uid));
    }
    // Exact keys, including nullable fields, without constructing the field list twice.
    function exactFields(value, fields) {
      return value is map && value.size() == fields.size() && value.keys().hasOnly(fields);
    }
    function date(value) { return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function text(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function responsible(value) {
      return value == null || (value is string && exists(/databases/$(database)/documents/households/family/members/$(value)));
    }
    function validDetails(d) {
      return exactFields(d, ['title', 'recipient', 'date', 'startTime', 'endTime', 'allDay', 'responsibleParentId', 'location', 'notes', 'reminderMinutes'])
        && text(d.title, 120) && d.recipient in ['FERDINAND', 'JOHANN', 'BOTH_CHILDREN', 'HOUSEHOLD']
        && date(d.date) && validTime(d.startTime) && validTime(d.endTime) && d.allDay is bool
        && (d.allDay || d.endTime > d.startTime) && responsible(d.responsibleParentId)
        && d.location is string && d.location.size() <= 300 && d.notes is string && d.notes.size() <= 2000
        && (d.reminderMinutes == null || (d.reminderMinutes is int &&
          ((d.allDay && d.reminderMinutes in [0, 1440]) || (!d.allDay && d.reminderMinutes in [0, 15, 30, 60, 1440]))));
    }
    function validTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    function validTimes(times) {
      return times is list && times.size() > 0 && times.size() <= 8 && times.toSet().size() == times.size()
        && validJoinedTimes(times.join(','), times.size());
    }
    function validJoinedTimes(joined, count) {
      // Each HH:mm occupies five characters plus one separator. The length check
      // prevents an element containing a comma from injecting extra time slots.
      return joined.size() == count * 6 - 1
        && joined.matches('^([01][0-9]|2[0-3]):[0-5][0-9](,([01][0-9]|2[0-3]):[0-5][0-9]){0,7}$');
    }
    function validTaskSnapshot(t) {
      let fields = ['id', 'taskId', 'childId', 'title', 'notes', 'frequency', 'weekdays', 'times', 'start', 'end', 'effective', 'active', 'createdMillis', 'authorId', 'responsibleParentId', 'slotOrigins'];
      return t is map && t.keys().hasAll(fields) && t.keys().hasOnly(fields.concat(['interval']))
        && text(t.id, 100) && text(t.taskId, 100) && t.childId in ['ferdinand', 'johann', 'haushalt']
        && text(t.title, 120) && t.notes is string && t.notes.size() <= 2000
        && t.frequency in ['ONCE', 'DAILY', 'WEEKDAYS', 'WEEKS', 'MONTHS'] && validTaskInterval(t)
        && t.weekdays is list && t.weekdays.size() <= 7
        && t.weekdays.hasOnly([1, 2, 3, 4, 5, 6, 7]) && (t.frequency != 'WEEKDAYS' || t.weekdays.size() > 0)
        && validTimes(t.times) && date(t.start) && date(t.effective) && (t.end == null || (date(t.end) && t.end >= t.start))
        && t.active is bool && t.createdMillis is int && t.authorId is string && responsible(t.responsibleParentId) && validOrigins(t.slotOrigins, t.times.size());
    }
    function validTaskInterval(t) {
      let interval = t.get('interval', 1);
      return interval is int && interval >= 1 && interval <= 1000
        && (t.frequency in ['DAILY', 'WEEKS', 'MONTHS'] || interval == 1);
    }
    function validOrigins(origins, count) {
      return origins is list && (origins.size() == 0 || (origins.size() == count
        && originAt(origins, 0) && originAt(origins, 1) && originAt(origins, 2) && originAt(origins, 3)
        && originAt(origins, 4) && originAt(origins, 5) && originAt(origins, 6) && originAt(origins, 7)));
    }
    function originAt(origins, index) {
      return origins.size() <= index || validOrigin(origins[index]);
    }
    function validOrigin(value) {
      return value is string && value.size() <= 120
        && value.matches('^[^|]+[|]([0-7]?[0-9]{1,4}|8[0-5][0-9]{3}|86[0-3][0-9]{2})$');
    }
    function validOccurrenceSnapshot(s, event) {
      return exactFields(s, ['revision', 'date', 'time', 'id', 'originalDate', 'originalTime', 'sourceId'])
        && validTaskSnapshot(s.revision) && s.id == event.occurrenceId && s.date == event.date
        && validTime(s.time) && date(s.originalDate) && validTime(s.originalTime) && text(s.sourceId, 100)
        && get(/databases/$(database)/documents/households/family/revisions/$(s.sourceId)).data.taskId == s.revision.taskId;
    }
    function validAppointmentSnapshot(a) {
      return exactFields(a, ['id', 'details', 'repeat', 'interval', 'until', 'fromDate'])
        && text(a.id, 100) && validDetails(a.details) && a.repeat in ['ONCE', 'DAYS', 'WEEKS', 'MONTHS', 'YEARS']
        && a.interval is int && a.interval >= 1 && a.interval <= 1000 && (a.repeat != 'ONCE' || a.interval == 1)
        && date(a.fromDate) && a.fromDate >= a.details.date && (a.until == null || (date(a.until) && a.until >= a.fromDate));
    }
    function validListLabel(d) {
      return exactFields(d, ['id', 'group', 'name', 'color', 'active', 'version'])
        && text(d.id, 100) && d.group in ['SHOPPING', 'OCCASION', 'GIVER'] && text(d.name, 60)
        && d.color in ['BLUE', 'ROSE', 'GREEN', 'HONEY', 'BROWN', 'PURPLE'] && d.active is bool
        && d.version is int && d.version >= 0;
    }
    function listLabelAt(d, index) {
      return d.labelIds.size() <= index || (text(d.labelIds[index], 100)
        && ((d.kind == 'SHOPPING' && get(/databases/$(database)/documents/households/family/listLabels/$(d.labelIds[index])).data.group == 'SHOPPING')
          || (d.kind == 'GIFTS' && get(/databases/$(database)/documents/households/family/listLabels/$(d.labelIds[index])).data.group in ['OCCASION', 'GIVER'])));
    }
    function validListItem(d) {
      return exactFields(d, ['id', 'kind', 'title', 'notes', 'recipient', 'labelIds', 'version', 'deleted', 'lastActivityId'])
        && text(d.id, 100) && text(d.title, 120) && d.notes is string && d.notes.size() <= 2000
        && ((d.kind == 'SHOPPING' && d.recipient == null) || (d.kind == 'GIFTS' && d.recipient in ['FERDINAND', 'JOHANN', 'BOTH_CHILDREN']))
        && d.version is int && d.version >= 0 && d.deleted is bool && text(d.lastActivityId, 100)
        && d.labelIds is list && d.labelIds.size() <= 6 && d.labelIds.toSet().size() == d.labelIds.size()
        && listLabelAt(d, 0) && listLabelAt(d, 1) && listLabelAt(d, 2) && listLabelAt(d, 3) && listLabelAt(d, 4) && listLabelAt(d, 5);
    }
    function validActivityLabel(label, id) {
      let current = get(/databases/$(database)/documents/households/family/listLabels/$(id)).data;
      // Current labels already passed the label-document schema. Retain validation for
      // historical names/colors so archived or renamed labels keep their audit snapshots.
      return label == current || (label is map
        && label.diff(current).affectedKeys().hasOnly(['name', 'color', 'active', 'version'])
        && text(label.name, 60) && label.color in ['BLUE', 'ROSE', 'GREEN', 'HONEY', 'BROWN', 'PURPLE']
        && label.active is bool && label.version is int && label.version >= 0);
    }
    function activityLabelAt(d, index) {
      return d.labels.size() <= index || validActivityLabel(d.labels[index], d.snapshot.labelIds[index]);
    }
    match /households/family/listLabels/{labelId} {
      allow read: if member();
      allow create: if member() && validListLabel(request.resource.data) && request.resource.data.id == labelId && request.resource.data.version == 0;
      allow update: if member() && validListLabel(request.resource.data) && request.resource.data.id == labelId
        && request.resource.data.group == resource.data.group && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }
    match /households/family/listItems/{itemId} {
      function pairedActivity() {
        let d = request.resource.data;
        let a = getAfter(/databases/$(database)/documents/households/family/listActivity/$(d.lastActivityId)).data;
        return a.itemId == itemId && a.snapshot == d && a.authorId == request.auth.uid && a.createdAt == request.time;
      }
      function updateAction() {
        let d = request.resource.data;
        let action = getAfter(/databases/$(database)/documents/households/family/listActivity/$(d.lastActivityId)).data.action;
        return (action == 'CHANGED' && !resource.data.deleted && !d.deleted)
          || (action == 'DELETED' && !resource.data.deleted && d.deleted
            && d.diff(resource.data).affectedKeys().hasOnly(['version', 'deleted', 'lastActivityId']))
          || (action == 'RESTORED' && resource.data.deleted && !d.deleted
            && d.diff(resource.data).affectedKeys().hasOnly(['version', 'deleted', 'lastActivityId']));
      }
      allow read: if member();
      allow create: if member() && validListItem(request.resource.data) && request.resource.data.id == itemId
        && request.resource.data.version == 0 && !request.resource.data.deleted && pairedActivity()
        && getAfter(/databases/$(database)/documents/households/family/listActivity/$(request.resource.data.lastActivityId)).data.action == 'ADDED';
      allow update: if member() && validListItem(request.resource.data) && request.resource.data.id == itemId
        && request.resource.data.kind == resource.data.kind && request.resource.data.version == resource.data.version + 1
        && pairedActivity() && updateAction();
      allow delete: if false;
    }
    match /households/family/listActivity/{eventId} {
      function validListActivity() {
        let d = request.resource.data;
        let after = getAfter(/databases/$(database)/documents/households/family/listItems/$(d.itemId)).data;
        return d.keys().hasAll(['id', 'itemId', 'action', 'snapshot', 'labels', 'authorId', 'authorName', 'clientMillis', 'createdAt', 'targetId'])
          && d.keys().hasOnly(['id', 'itemId', 'action', 'snapshot', 'labels', 'authorId', 'authorName', 'clientMillis', 'createdAt', 'targetId'])
          // Snapshot validity follows from equality with the atomically validated item below,
          // or an immutable, previously validated audit for offline purchases/reopenings.
          // Revalidating all six label references here exhausts the expression budget.
          && d.id == eventId && text(d.itemId, 100) && d.snapshot.id == d.itemId && after.kind == d.snapshot.kind
          && d.authorId == request.auth.uid && text(d.authorName, 120) && d.createdAt == request.time && d.clientMillis is int
          && d.labels is list && d.labels.size() == d.snapshot.labelIds.size()
          && activityLabelAt(d, 0) && activityLabelAt(d, 1) && activityLabelAt(d, 2) && activityLabelAt(d, 3) && activityLabelAt(d, 4) && activityLabelAt(d, 5)
          && ((d.action == 'BOUGHT' && d.targetId == null
              && get(/databases/$(database)/documents/households/family/listActivity/$(d.snapshot.lastActivityId)).data.snapshot == d.snapshot)
            || (d.action == 'REOPENED' && text(d.targetId, 100)
              && get(/databases/$(database)/documents/households/family/listActivity/$(d.snapshot.lastActivityId)).data.snapshot == d.snapshot
              && get(/databases/$(database)/documents/households/family/listActivity/$(d.targetId)).data.action == 'BOUGHT'
              && get(/databases/$(database)/documents/households/family/listActivity/$(d.targetId)).data.itemId == d.itemId)
            || (d.action in ['ADDED', 'CHANGED', 'DELETED', 'RESTORED'] && d.targetId == null
              && after.lastActivityId == eventId && after == d.snapshot
              && ((d.action == 'ADDED' && !exists(/databases/$(database)/documents/households/family/listItems/$(d.itemId)))
                || (d.action != 'ADDED' && after.version == get(/databases/$(database)/documents/households/family/listItems/$(d.itemId)).data.version + 1))));
      }
      allow read: if member();
      allow create: if member() && validListActivity();
      allow update, delete: if false;
    }
    match /households/family/members/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || member());
      allow list: if member();
      allow write: if false;
    }
    match /households/family/children/{childId} {
      allow read: if member();
      allow update: if member() && request.resource.data.keys().hasOnly(['name', 'bearColor'])
        && text(request.resource.data.name, 60)
        && (!('bearColor' in request.resource.data)
          || request.resource.data.bearColor in ['BLUE', 'ROSE', 'GREEN', 'HONEY', 'BROWN', 'PURPLE']);
      allow create, delete: if false;
    }
    match /households/family/revisions/{revisionId} {
      allow read: if member();
      allow create: if member() && request.resource.data.keys().hasAll([
          'taskId', 'childId', 'title', 'notes', 'frequency', 'weekdays', 'times', 'start', 'end', 'effective', 'active', 'authorId', 'createdAt'])
        && request.resource.data.keys().hasOnly([
          'taskId', 'childId', 'title', 'notes', 'frequency', 'weekdays', 'times', 'start', 'end', 'effective', 'active', 'authorId', 'createdAt', 'responsibleParentId', 'interval'])
        && text(request.resource.data.taskId, 100)
        && (!('responsibleParentId' in request.resource.data) || responsible(request.resource.data.responsibleParentId))
        && request.resource.data.childId in ['ferdinand', 'johann', 'haushalt']
        && text(request.resource.data.title, 120)
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 2000
        && request.resource.data.frequency in ['ONCE', 'DAILY', 'WEEKDAYS', 'WEEKS', 'MONTHS']
        && validTaskInterval(request.resource.data)
        && request.resource.data.weekdays is list
        && request.resource.data.weekdays.size() <= 7
        && request.resource.data.weekdays.hasOnly([1, 2, 3, 4, 5, 6, 7])
        && (request.resource.data.frequency != 'WEEKDAYS' || request.resource.data.weekdays.size() > 0)
        && validTimes(request.resource.data.times)
        && date(request.resource.data.start) && date(request.resource.data.effective)
        && (request.resource.data.end == null || (date(request.resource.data.end) && request.resource.data.end >= request.resource.data.start))
        && request.resource.data.active is bool
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /households/family/events/{eventId} {
      function validEvent(d) {
        return d.keys().hasAll([
          'occurrenceId', 'date', 'kind', 'authorId', 'authorName', 'clientMillis', 'createdAt', 'targetId'])
        && d.keys().hasOnly([
          'occurrenceId', 'date', 'kind', 'authorId', 'authorName', 'clientMillis', 'createdAt', 'targetId', 'completedById', 'completedByName', 'taskSnapshot'])
        && ((!('completedById' in d) && !('completedByName' in d))
          || (d.kind == 'COMPLETE'
            && d.keys().hasAll(['completedById', 'completedByName'])
            && d.completedById is string
            && responsible(d.completedById)
            && text(d.completedByName, 120)))
        && (!('taskSnapshot' in d) || validOccurrenceSnapshot(d.taskSnapshot, d))
        && text(d.occurrenceId, 300) && date(d.date)
        && d.authorId == request.auth.uid
        && text(d.authorName, 120)
        && d.clientMillis is int
        && d.createdAt == request.time
        && ((d.kind == 'COMPLETE' && d.targetId == null)
          || (d.kind == 'RETRACT' && text(d.targetId, 100)
            && get(/databases/$(database)/documents/households/family/events/$(d.targetId)).data.kind == 'COMPLETE'
            && get(/databases/$(database)/documents/households/family/events/$(d.targetId)).data.occurrenceId == d.occurrenceId
            && get(/databases/$(database)/documents/households/family/events/$(d.targetId)).data.date == d.date));
      }
      allow read: if member();
      allow create: if member() && validEvent(request.resource.data);
      allow update, delete: if false;
    }
    match /households/family/appointmentSeries/{seriesId} {
      allow read: if member();
      allow create: if member()
        && request.resource.data.keys().hasAll(['details', 'repeat', 'interval', 'until', 'cutoff', 'version', 'authorId', 'createdAt', 'fromDate'])
        && request.resource.data.keys().hasOnly(['details', 'repeat', 'interval', 'until', 'cutoff', 'version', 'authorId', 'createdAt', 'fromDate', 'rootId'])
        && (!('rootId' in request.resource.data) || (text(request.resource.data.rootId, 100)
          && (request.resource.data.rootId == seriesId || exists(/databases/$(database)/documents/households/family/appointmentSeries/$(request.resource.data.rootId)))))
        && validDetails(request.resource.data.details)
        && request.resource.data.repeat in ['ONCE', 'DAYS', 'WEEKS', 'MONTHS', 'YEARS']
        && request.resource.data.interval is int && request.resource.data.interval >= 1 && request.resource.data.interval <= 1000
        && (request.resource.data.repeat != 'ONCE' || request.resource.data.interval == 1)
        && date(request.resource.data.fromDate) && request.resource.data.fromDate >= request.resource.data.details.date
        && (request.resource.data.repeat != 'ONCE' || request.resource.data.fromDate == request.resource.data.details.date)
        && (request.resource.data.until == null || (date(request.resource.data.until) && request.resource.data.until >= request.resource.data.fromDate))
        && request.resource.data.cutoff == null && request.resource.data.version is int && request.resource.data.version == 0
        && request.resource.data.authorId == request.auth.uid && request.resource.data.createdAt == request.time;
      // Definitions are preserved. Only the exclusive future boundary can be shortened.
      allow update: if member() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cutoff', 'version'])
        && date(request.resource.data.cutoff) && (resource.data.cutoff == null || request.resource.data.cutoff < resource.data.cutoff)
        && request.resource.data.version is int && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }
    match /households/family/appointmentActivity/{activityId} {
      function changedSeries(d) {
        let before = get(/databases/$(database)/documents/households/family/appointmentSeries/$(d.seriesId)).data;
        let after = getAfter(/databases/$(database)/documents/households/family/appointmentSeries/$(d.seriesId)).data;
        return after.cutoff == d.originalDate && after.version == before.version + 1
          && ((d.kind == 'CANCELLED' && d.resultSeriesId == null)
            || (d.kind == 'CHANGED' && d.resultSeriesId is string
              && getAfter(/databases/$(database)/documents/households/family/appointmentSeries/$(d.resultSeriesId)).data.createdAt == request.time
              && getAfter(/databases/$(database)/documents/households/family/appointmentSeries/$(d.resultSeriesId)).data.authorId == request.auth.uid
              && getAfter(/databases/$(database)/documents/households/family/appointmentSeries/$(d.resultSeriesId)).data.details == d.details));
      }
      function changedOccurrence(d) {
        let key = d.seriesId + '_' + d.originalDate;
        let after = getAfter(/databases/$(database)/documents/households/family/appointmentExceptions/$(key)).data;
        return d.resultSeriesId == null && after.updatedAt == request.time && after.authorId == request.auth.uid
          && ((d.kind == 'CANCELLED' && after.replacement == null)
            || (d.kind == 'CHANGED' && after.replacement == d.details));
      }
      function addedSeries(d) {
        let after = getAfter(/databases/$(database)/documents/households/family/appointmentSeries/$(d.seriesId)).data;
        return !d.following && d.resultSeriesId == null && after.createdAt == request.time
          && after.authorId == request.auth.uid && after.fromDate == d.originalDate && after.details == d.details;
      }
      allow read: if member();
      allow create: if member()
        && request.resource.data.keys().hasAll(['seriesId', 'originalDate', 'kind', 'following', 'details', 'resultSeriesId', 'authorId', 'authorName', 'createdAt'])
        && request.resource.data.keys().hasOnly(['seriesId', 'originalDate', 'kind', 'following', 'details', 'resultSeriesId', 'authorId', 'authorName', 'createdAt'])
        && text(request.resource.data.seriesId, 100) && date(request.resource.data.originalDate)
        && request.resource.data.kind in ['ADDED', 'CHANGED', 'CANCELLED']
        && request.resource.data.following is bool && validDetails(request.resource.data.details)
        && (request.resource.data.resultSeriesId == null || text(request.resource.data.resultSeriesId, 100))
        && request.resource.data.authorId == request.auth.uid && text(request.resource.data.authorName, 120)
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.kind == 'ADDED' && addedSeries(request.resource.data))
          || (request.resource.data.kind != 'ADDED'
            && ((request.resource.data.following && changedSeries(request.resource.data))
              || (!request.resource.data.following && changedOccurrence(request.resource.data)))));
      allow update, delete: if false;
    }
    match /households/family/appointmentExceptions/{exceptionId} {
      function validException() {
        let d = request.resource.data;
        let series = get(/databases/$(database)/documents/households/family/appointmentSeries/$(d.seriesId)).data;
        return d.keys().hasAll(['seriesId', 'originalDate', 'replacement', 'version', 'seriesVersion', 'authorId', 'updatedAt'])
          && d.keys().hasOnly(['seriesId', 'originalDate', 'replacement', 'version', 'seriesVersion', 'authorId', 'updatedAt'])
          && text(d.seriesId, 100) && date(d.originalDate) && exceptionId == d.seriesId + '_' + d.originalDate
          && d.originalDate >= series.fromDate && (series.until == null || d.originalDate <= series.until)
          && (series.cutoff == null || d.originalDate < series.cutoff)
          && (d.replacement == null || validDetails(d.replacement))
          && d.seriesVersion == series.version && d.version is int
          && d.authorId == request.auth.uid && d.updatedAt == request.time;
      }
      allow read: if member();
      allow create: if member() && validException() && request.resource.data.version == 0;
      allow update: if member() && validException()
        && request.resource.data.seriesId == resource.data.seriesId && request.resource.data.originalDate == resource.data.originalDate
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }
    match /households/family/itemControls/{controlId} {
      function validControl() {
        let d = request.resource.data;
        let op = getAfter(/databases/$(database)/documents/households/family/itemOperations/$(d.operationId)).data;
        return d.keys().hasAll(['version', 'operationId', 'authorId', 'updatedAt'])
          && d.keys().hasOnly(['version', 'operationId', 'authorId', 'updatedAt'])
          && text(d.operationId, 100) && d.authorId == request.auth.uid && d.updatedAt == request.time
          && d.version is int && op.version == d.version && op.authorId == request.auth.uid && op.createdAt == request.time
          && controlId == op.type + '_' + op.itemId;
      }
      allow read: if member();
      allow create: if member() && validControl() && request.resource.data.version == 1;
      allow update: if member() && validControl() && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }
    match /households/family/itemOperations/{operationId} {
      function validOperation() {
        let d = request.resource.data;
        let key = d.type + '_' + d.itemId;
        let control = getAfter(/databases/$(database)/documents/households/family/itemControls/$(key)).data;
        return exactFields(d, ['type', 'itemId', 'action', 'scope', 'anchorId', 'anchorDate', 'anchorTime', 'sourceId', 'title', 'actualDate', 'actualStartAt', 'replacementStartAt', 'childId', 'recipient', 'task', 'appointment', 'restoresId', 'createdAt', 'authorId', 'authorName', 'version'])
          && d.type in ['TASK', 'APPOINTMENT'] && text(d.itemId, 100) && text(d.sourceId, 100)
          && d.action in ['EDIT', 'DELETE', 'RESTORE'] && d.scope in ['SINGLE', 'FOLLOWING', 'ALL']
          && text(d.anchorId, 300) && date(d.anchorDate) && validTime(d.anchorTime) && text(d.title, 120)
          && date(d.actualDate) && d.actualStartAt is timestamp && (d.replacementStartAt == null || d.replacementStartAt is timestamp)
          && d.authorId == request.auth.uid && text(d.authorName, 120) && d.createdAt == request.time
          && d.version is int && control.version == d.version && control.operationId == operationId
          && control.updatedAt == request.time && control.authorId == request.auth.uid
          && ((d.type == 'TASK' && d.childId in ['ferdinand', 'johann', 'haushalt'] && d.recipient == null
              && get(/databases/$(database)/documents/households/family/revisions/$(d.sourceId)).data.taskId == d.itemId)
            || (d.type == 'APPOINTMENT' && d.childId == null && d.recipient in ['FERDINAND', 'JOHANN', 'BOTH_CHILDREN', 'HOUSEHOLD']
              && exists(/databases/$(database)/documents/households/family/appointmentSeries/$(d.sourceId))))
          && ((d.action == 'EDIT' && d.scope in ['SINGLE', 'FOLLOWING'] && d.restoresId == null
              && (d.actualStartAt > request.time
                || (d.type == 'TASK' && d.scope == 'SINGLE'
                  && get(/databases/$(database)/documents/households/family/revisions/$(d.sourceId)).data.frequency == 'ONCE'))
              && ((d.type == 'TASK' && validTaskSnapshot(d.task) && d.task.taskId == d.itemId && d.appointment == null
                  && (d.scope != 'SINGLE' || (d.task.times.size() == 1 && d.replacementStartAt is timestamp)))
                || (d.type == 'APPOINTMENT' && d.task == null && validAppointmentSnapshot(d.appointment) && d.replacementStartAt > request.time)))
            || (d.action == 'DELETE' && d.task == null && d.appointment == null && d.restoresId == null)
            || (d.action == 'RESTORE' && d.task == null && d.appointment == null && text(d.restoresId, 100)
              && get(/databases/$(database)/documents/households/family/itemOperations/$(d.restoresId)).data.action == 'DELETE'
              && get(/databases/$(database)/documents/households/family/itemOperations/$(d.restoresId)).data.itemId == d.itemId
              && get(/databases/$(database)/documents/households/family/itemOperations/$(d.restoresId)).data.type == d.type
              && get(/databases/$(database)/documents/households/family/itemOperations/$(d.restoresId)).data.scope == d.scope
              && get(/databases/$(database)/documents/households/family/itemOperations/$(d.restoresId)).data.anchorId == d.anchorId));
      }
      allow read: if member();
      allow create: if member() && validOperation();
      allow update, delete: if false;
    }
  }
}
